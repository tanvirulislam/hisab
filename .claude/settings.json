{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(cd /home/spordium/.claude/projects/-run-media-spordium-New-Volume-projects-Linux--hisab/memory && ls -la && cat hisab-decision-autonomy.md MEMORY.md; ls /home/spordium/.claude/*.md)",
      "Read(//home/spordium/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/spordium/.local/bin/graphify hook-guard search",
